# Solana devnet settlement with Helius Privacy Rings. Test money only. Never commit .env.local.
# Local development: put HELIUS_API_KEY here and the wallet keys in .solana-keys/ (gitignored),
# then run `npm run solana:setup`. Public addresses live in deployments/solana-devnet.json.
HELIUS_API_KEY=                # Helius devnet API key (Privacy Rings needs the Helius RPC and indexer)

# Hosted deploy: no .solana-keys/ on the server, so pass each wallet as a secret env var.
# Format: the JSON byte array that solana-keygen writes ([12,34,...], 64 bytes) or base58 of the 64-byte secret.
# SOLANA_UNDERWRITER_KEY=      # funds step vaults privately, reclaims untriggered steps
# SOLANA_ORACLE_KEY=           # posts the EIA monthly mean; must match ORACLE in solana/program/src/lib.rs
# SOLANA_FLEET_KEY=            # demo wallet standing in for the business; signs releases
# SOLANA_PAYER_KEY=            # optional: tops up SOL for the wallets above (setup and low balances)

# Optional overrides (defaults come from deployments/solana-devnet.json)
# SOLANA_RPC_URL=              # full RPC URL instead of HELIUS_API_KEY
# SOLANA_PROGRAM_ID=
# SOLANA_TUSD_MINT=
# SOLANA_TUSD_ASSET_ID=
# SOLANA_EXPLORER=https://explorer.solana.com
# SOLANA_KEYS_DIR=.solana-keys

# Archived Arc testnet settlement (lib/chain/arc, scripts/chain.ts); unused by the app.
# UNDERWRITER_PRIVATE_KEY=0x
# ORACLE_PRIVATE_KEY=0x
# BENEFICIARY_PRIVATE_KEY=0x

# Ledger sign-in. Leave a pair blank and that button stays off. Redirect URLs must be
# {origin}/api/connect/quickbooks/callback, /xero/callback, /zoho/callback, /freshbooks/callback.
# CONNECT_STATE_SECRET=            # signs the login attempt; falls back to a client secret
# CONNECT_REDIRECT_ORIGIN=http://localhost:3000
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox   # or production, after Intuit's app assessment
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_ORGANIZATION_ID=
# FRESHBOOKS_CLIENT_ID=
# FRESHBOOKS_CLIENT_SECRET=
